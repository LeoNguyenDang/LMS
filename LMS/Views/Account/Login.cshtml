@model LMS.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - KFC LMS</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
</head>
<body>
    <main class="login-layout">

        <!-- CỘT TRÁI: NHẬN DIỆN THƯƠNG HIỆU -->
        <section class="brand-panel"
                 aria-label="Hệ thống học tập KFC">

            <div class="brand-top">

                @* Khi có hình, thay ô LOGO bằng:
                <img class="brand-logo"
                     src="~/images/logo.png"
                     alt="KFC" />
                *@

                <img class="brand-logo"
                     src="~/images/kfc-logo.png"
                     asp-append-version="true"
                     alt="KFC" />

                <span class="brand-divider"
                      aria-hidden="true"></span>

                <p class="brand-name">
                    LEARNING<br />
                    MANAGEMENT SYSTEM
                </p>
            </div>

            <!-- Sửa các đoạn chữ giới thiệu tại đây -->
            <div class="brand-message">
                <p class="brand-eyebrow">
                    HỌC TẬP &amp; PHÁT TRIỂN
                </p>

                <h1>
                    MỖI NGÀY,<br />
                    MỘT BƯỚC<br />
                    TIẾN MỚI.
                </h1>

                <p class="brand-description">
                    Kiến thức hôm nay.<br />
                    Tự tin hơn trong từng công việc ngày mai.
                </p>
            </div>

            <p class="brand-footer">
                <span aria-hidden="true"></span>
                CÙNG NHAU PHÁT TRIỂN.
            </p>
        </section>

        <!-- CỘT PHẢI: FORM ĐĂNG NHẬP -->
        <section class="form-panel"
                 aria-labelledby="login-title">

            <div class="form-wrap">

                <div class="section-marker"
                     aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <p class="form-eyebrow">
                    CHÀO MỪNG TRỞ LẠI
                </p>

                <h2 id="login-title">Đăng nhập</h2>

                <p class="form-intro">
                    Đăng nhập để tiếp tục học tập và phát triển.
                </p>

                <form asp-controller="Account"
                      asp-action="Login"
                      asp-route-returnUrl="@returnUrl"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary"
                         role="alert">
                    </div>

                    <!-- TÀI KHOẢN -->
                    <div class="field">
                        <label asp-for="UserName">
                            Tài khoản
                        </label>

                        <input asp-for="UserName"
                               autocomplete="username"
                               autocapitalize="none"
                               spellcheck="false"
                               placeholder="Tên đăng nhập hoặc mã nhân viên"
                               aria-describedby="username-validation" />

                        <span asp-validation-for="UserName"
                              id="username-validation"
                              class="field-validation"
                              aria-live="polite">
                        </span>
                    </div>

                    <!-- MẬT KHẨU -->
                    <div class="field">
                        <label asp-for="Password">
                            Mật khẩu
                        </label>

                        <div class="password-wrap">
                            <input asp-for="Password"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="Nhập mật khẩu"
                                   aria-describedby="password-validation" />

                            @* Nút này sẽ được bật khi thêm JavaScript ở bước sau. *@
                            <button type="button"
                                    id="toggle-password"
                                    class="password-toggle"
                                    aria-label="Hiện mật khẩu"
                                    aria-controls="Password"
                                    aria-pressed="false"
                                    hidden>
                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.6"
                                     aria-hidden="true"
                                     focusable="false">
                                    <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>

                        <span asp-validation-for="Password"
                              id="password-validation"
                              class="field-validation"
                              aria-live="polite">
                        </span>
                    </div>

                    <!-- GHI NHỚ VÀ HỖ TRỢ MẬT KHẨU -->
                    <div class="form-options">
                        <label class="remember">
                            <input asp-for="RememberMe" />
                            <span>Ghi nhớ đăng nhập</span>
                        </label>

                        <details class="password-help">
                            <summary>Quên mật khẩu?</summary>

                            <p>
                                Vui lòng liên hệ quản trị viên LMS
                                tại đơn vị để được hỗ trợ đặt lại mật khẩu.
                            </p>
                        </details>
                    </div>

                    <!-- NÚT ĐĂNG NHẬP -->
                    <button type="submit"
                            class="submit-button">
                        <span>Đăng nhập</span>

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             aria-hidden="true"
                             focusable="false">
                            <path d="M4 12h15m-6-6 6 6-6 6" />
                        </svg>
                    </button>
                </form>

                <!-- HỖ TRỢ TÀI KHOẢN -->
                <div class="support">
                    <span class="support-icon"
                          aria-hidden="true">
                        ?
                    </span>

                    <div>
                        <p>Cần hỗ trợ truy cập?</p>

                        <details>
                            <summary>
                                Liên hệ quản trị viên LMS
                            </summary>

                            <p>
                                Liên hệ quản trị viên LMS tại nhà hàng
                                hoặc đơn vị của bạn để được hỗ trợ tài khoản.
                            </p>
                        </details>
                    </div>
                </div>
            </div>

            <footer class="page-footer">
                HỆ THỐNG HỌC TẬP NỘI BỘ KFC
            </footer>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/login.js"
        asp-append-version="true"></script>

</body>
</html>