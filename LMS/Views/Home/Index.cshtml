@{
    ViewData["Title"] = "Trang chủ";
}

<section class="mb-4">
    <h2 class="h4">Chào mừng đến với KFC LMS</h2>

    <p class="text-secondary">
        Truy cập khóa học và cập nhật tin tức nội bộ.
    </p>
</section>

<div class="row g-4">

    <!-- KHÓA HỌC -->
    <div class="col-12 col-md-6">
        <section class="bg-white border rounded p-4 h-100">
            <h3 class="h5">Khóa học</h3>

            <p class="text-secondary">
                Khám phá nội dung đào tạo và phát triển kỹ năng.
            </p>

            <a asp-controller="Course"
               asp-action="Index"
               class="btn btn-dark">
                Xem khóa học
            </a>
        </section>
    </div>

    <!-- TIN TỨC -->
    <div class="col-12 col-md-6">
        <section class="bg-white border rounded p-4 h-100">
            <h3 class="h5">Tin tức</h3>

            <p class="text-secondary">
                Cập nhật thông tin và hoạt động mới nhất tại KFC.
            </p>

            <a asp-controller="News"
               asp-action="Index"
               class="btn btn-dark">
                Xem tin tức
            </a>
        </section>
    </div>

</div>